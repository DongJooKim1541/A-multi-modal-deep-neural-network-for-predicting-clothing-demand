# kim2022multi Configuration
# Copy this file to .env and customize values

# Training Configuration
BATCH_SIZE=64
NUM_EPOCHS=3000
LR=0.0001
WEIGHT_DECAY=1e-5
CLIP_NORM=5

# Focal Loss
FOCAL_ALPHA=1
FOCAL_GAMMA=2

# Loss Weights
LOSS_ALPHA=0.01
LOSS_BETA=0.01

# Text encoder
BERT_MODEL_NAME=bert-base-multilingual-cased
BERT_FEATURE_DIM=768

# Image preprocessing
IMAGE_SIZE=125
CROP_SCALE=0.1,1
CROP_RATIO=0.5,2
NORM_MEAN=0.485,0.456,0.406
NORM_STD=0.229,0.224,0.225

# Model
# IMAGE_FEATURE_DIM is the flattened CNN output for IMAGE_SIZE=125.
# Changing IMAGE_SIZE requires recomputing it.
IMAGE_FEATURE_DIM=512
META_FEATURE_DIM=3
FUSION_HIDDEN_DIM=64
DROPOUT_RATE=0.5
NUM_BEST_SEX_CLASS=3
NUM_BEST_AGE_CLASS=7
NUM_SALES_CLASS=7

# Data split
SPLIT_RANDOM_STATE=0

# DataLoader worker processes (defaults to 0 on Windows, 4 elsewhere)
# NUM_WORKERS=4

# CUDA
CUDA_VISIBLE_DEVICES=0

# Data Paths (optional - uses default PROJECT_ROOT/dataset if not set)
# DATA_PATH=/path/to/dataset/category_all_ver2_20221002_words_125_aug
# CSV_PATH=/path/to/dataset/goodsNum_clothing_name_20221002.csv

# Checkpoint Paths
# CHECKPOINT_DIR=/path/to/checkpoints
# RESULTS_DIR=/path/to/results
